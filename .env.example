# Copy to .env.local for personal overrides (optional)
# Next.js loads .env.development in `npm run dev` and .env.production in `npm run build`

# App identity
NEXT_PUBLIC_APP_NAME=Hexaground
NEXT_PUBLIC_APP_ENV=development

# Public URL (update for production deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LocalStorage key prefix (use different values per environment to avoid data clashes)
NEXT_PUBLIC_STORAGE_PREFIX=hexaground

# Contact address shown on the privacy policy page (leave empty to hide it)
NEXT_PUBLIC_CONTACT_EMAIL=

# Enable debug helpers in the UI
NEXT_PUBLIC_ENABLE_DEBUG=false

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hexelly-8e1c2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hexelly-8e1c2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hexelly-8e1c2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
